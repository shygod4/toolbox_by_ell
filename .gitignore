!CATALOG.md
!HOWTO_UPDATE.txt
!手动同步.cmd

!bin/
!sync/
!config/
!doc/
!index/
!scripts/
!temp/

# 但忽略其中的二进制/数据文件
bin/*
!bin/*.bat

temp/*
!temp/.gitkeep

# 装机手册
